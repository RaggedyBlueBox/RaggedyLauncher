<Page
    x:Class="RaggedyLauncher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <Grid Padding="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14" Margin="0,0,0,24">
            <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource AccentBlueBrush}">
                <Image Source="ms-appx:///Assets/Square44x44Logo.png" Stretch="Uniform"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RAGGEDY LAUNCHER" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" CharacterSpacing="3"/>
                <TextBlock Text="Controller-first Minecraft Java on Xbox" FontSize="14" Foreground="{ThemeResource MutedBrush}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" CornerRadius="22" Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource PanelAltBrush}" BorderThickness="2" Padding="34" Margin="0,0,18,0">
            <StackPanel Spacing="18" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Raggedy Launcher" FontSize="14" Foreground="{ThemeResource AccentMintBrush}" CharacterSpacing="2"/>
                <TextBlock x:Name="HeadingText" Text="Sign in with Microsoft" FontSize="40" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="InstructionsText" Text="Open the link on your phone or computer, then enter this code." FontSize="18" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>

                <Border x:Name="QrCard" Width="224" Height="224" CornerRadius="18" Background="White" Padding="18" HorizontalAlignment="Left" BorderBrush="{ThemeResource FocusBrush}" BorderThickness="3">
                    <Image x:Name="QrImage" Width="188" Height="188" Stretch="Uniform"/>
                </Border>

                <Border CornerRadius="16" Background="{ThemeResource PanelAltBrush}" Padding="20,14" HorizontalAlignment="Left" BorderBrush="{ThemeResource AccentBlueBrush}" BorderThickness="2">
                    <TextBlock x:Name="CodeText" Text="---- ----" FontSize="34" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" CharacterSpacing="4"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" CornerRadius="22" Background="{ThemeResource PanelAltBrush}" Padding="34" Margin="18,0,0,0">
            <StackPanel Spacing="20" VerticalAlignment="Center">
                <TextBlock Text="How to sign in" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"/>

                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{ThemeResource AccentMintBrush}">
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#0B1020"/>
                    </Border>
                    <TextBlock Text="Scan the code or open the link on another device." FontSize="18" Foreground="{ThemeResource TextBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{ThemeResource AccentBlueBrush}">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#0B1020"/>
                    </Border>
                    <TextBlock Text="Enter the code shown on the left." FontSize="18" Foreground="{ThemeResource TextBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{ThemeResource FocusBrush}">
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#0B1020"/>
                    </Border>
                    <TextBlock Text="Approve sign-in, then wait for ownership verification." FontSize="18" Foreground="{ThemeResource TextBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <Border CornerRadius="14" Background="{ThemeResource PanelBrush}" Padding="18" BorderBrush="{ThemeResource AccentMintBrush}" BorderThickness="2">
                    <TextBlock x:Name="LinkText" Text="microsoft.com/link" FontSize="18" Foreground="{ThemeResource AccentMintBrush}" TextWrapping="Wrap"/>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ProgressRing x:Name="SignInProgress" Width="28" Height="28" IsActive="False" Foreground="{ThemeResource AccentMintBrush}"/>
                    <TextBlock x:Name="StatusText" Text="Ready when you are." FontSize="18" Foreground="{ThemeResource TextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="BackButton" Content="Back" MinWidth="130" Height="48"/>
            <Button x:Name="RetryButton" Content="Try again" MinWidth="150" Height="48" Background="{ThemeResource AccentBlueBrush}" Foreground="{ThemeResource TextBrush}"/>
            <Button x:Name="CopyButton" Content="Copy code" MinWidth="150" Height="48" Background="{ThemeResource AccentMintBrush}" Foreground="#0B1020"/>
        </StackPanel>
    </Grid>
</Page>
