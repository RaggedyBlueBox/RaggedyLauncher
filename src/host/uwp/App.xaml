<Application
    x:Class="RaggedyLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1020"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#141B36"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1B2444"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F6FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A8B6D8"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#3E85FF"/>
        <SolidColorBrush x:Key="AccentMintBrush" Color="#4FE2C1"/>
        <SolidColorBrush x:Key="FocusBrush" Color="#FFCD52"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6464"/>
    </Application.Resources>
</Application>
